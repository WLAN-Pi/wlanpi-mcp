# Build the wlanpi-mcp Debian package on Debian trixie.
#
#   podman build -f Dockerfile.build -t wlanpi-mcp-builder:trixie .
#   podman run --rm -v "$(pwd)":/work -w /work wlanpi-mcp-builder:trixie
#
# Works with docker too (swap podman -> docker). build-package-native.sh
# auto-detects podman or docker.

FROM debian:trixie

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    build-essential \
    debhelper \
    dh-python \
    dh-virtualenv \
    python3 \
    python3-dev \
    python3-setuptools \
    python3-venv \
    devscripts \
    equivs \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /work

CMD ["dpkg-buildpackage", "-us", "-uc", "-b"]
