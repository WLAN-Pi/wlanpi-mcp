[Unit]
Description=WLAN Pi MCP Server
Wants=wlanpi-core.service nginx.service
After=network.target wlanpi-core.service nginx.service

[Service]
Type=simple
User=wlanpi
Group=wlanpi
EnvironmentFile=/etc/wlanpi-mcp/config.env
ExecStart=/opt/wlanpi-mcp/bin/python -m wlanpi_mcp --transport streamable-http
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
