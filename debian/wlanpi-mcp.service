[Unit]
Description=WLAN Pi MCP Server
Wants=wlanpi-core.service nginx.service
After=network.target wlanpi-core.service nginx.service

[Service]
Type=simple
User=wlanpi
Group=wlanpi
EnvironmentFile=/etc/wlanpi-mcp/config.env
# Never write bytecode: at runtime Python creates __pycache__/*.pyc under the
# installed package, which dpkg does not own, so 'apt purge' cannot remove it
# and leaves /opt/wlanpi-mcp/.../site-packages/wlanpi_mcp behind. The package
# already ships without bytecode (dh_virtualenv --no-compile); keep it that way.
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/wlanpi-mcp/bin/python -m wlanpi_mcp --transport sse
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
